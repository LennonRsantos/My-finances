# Copie para .env.local e preencha com os dados do seu projeto Firebase
# (Console > Configurações do projeto > Seus apps > App da Web > SDK config).
# Sem essas variáveis o app roda só com dados locais no navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
